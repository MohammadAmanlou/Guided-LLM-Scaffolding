# Application
FLASK_ENV=dev

# Database
DB_NAME=aied_db
MONGO_DB_CONNECTION_STRING=mongodb://mongo:27017

# Authentication
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# OpenAI-compatible LLM provider
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_SUMMARY_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-large
AIED_REGISTER_URL=