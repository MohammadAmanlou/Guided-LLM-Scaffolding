{
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:import/recommended",
    "prettier"
  ],
  "plugins": ["react", "react-hooks", "import"],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "sourceType": "module"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["*.config.js"],
      "env": {
        "node": true,
        "browser": false
      },
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": ["*.jsx"],
      "env": {
        "browser": true,
        "node": false
      }
    }
  ]
}
